# Copy to .env. Set a stable random key (openssl rand -hex 32).
MEDIA_SIGNING_SECRET=
LOVE_DOMAIN=love.example.com
LOVE_PORT=3000
# Blank uses the HTTPS domain above plus Capacitor origins.
ALLOWED_ORIGINS=
# Use 1 for the single bundled Caddy proxy; use 0 for direct local-only access.
TRUST_PROXY=1
AI_ALLOWED_HOSTS=

# Bootstrap only the first administrator. Password minimum 12 characters.
# After creation, remove ADMIN_PASSWORD and use the management page to change it.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database: SQLite by default. PostgreSQL URL selects PostgreSQL.
DATABASE_PROVIDER=
DATABASE_URL=
# Used by ./love; sqlite, postgres (bundled), or external.
LOVE_DATABASE=sqlite
LOVE_HTTPS=1
POSTGRES_DB=love
POSTGRES_USER=love
POSTGRES_PASSWORD=
# Initial settings only apply before management configuration exists.
INITIAL_QUOTA_MIB=1024
INITIAL_REGISTRATION=closed
INITIAL_SMTP_HOST=
INITIAL_SMTP_PORT=587
INITIAL_SMTP_SECURITY=starttls
INITIAL_SMTP_USER=
INITIAL_SMTP_PASSWORD=
INITIAL_SMTP_FROM=
