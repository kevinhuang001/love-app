PORT=3000
DATABASE_PATH=../../data/love.sqlite
UPLOADS_PATH=../../data/media
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Production: set a random, stable value >=32 characters. Also encrypts AI credentials.
MEDIA_SIGNING_SECRET=
# AI_ALLOWED_HOSTS=ollama.example.internal
# TRUST_PROXY=1 (only when behind exactly one trusted reverse proxy)

# Docker HTTPS deployment: public DNS must resolve to this host (ports 80/443).
LOVE_DOMAIN=love.example.com
LOVE_PORT=3000

# Bootstrap only the first administrator. Password minimum 12 characters.
# After creation, remove ADMIN_PASSWORD and use the management page to change it.
ADMIN_USERNAME=
ADMIN_PASSWORD=

