    "helmet": "8.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
