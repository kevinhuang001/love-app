# Copy to .env. Set a stable random key (openssl rand -hex 32).
MEDIA_SIGNING_SECRET=
LOVE_DOMAIN=love.example.com
LOVE_PORT=3000
# HTTP host binding: 127.0.0.1, 0.0.0.0 (all IPv4 interfaces), or a host interface IP.
LOVE_BIND_IP=127.0.0.1
# The interactive manager downloads prebuilt images; it never builds locally.
LOVE_IMAGE=ghcr.io/kevinhuang001/love-app:latest
# Blank uses the HTTPS domain above plus Capacitor origins.
ALLOWED_ORIGINS=
# Use 1 for the single bundled Caddy with loopback HTTP binding; use 0 for direct HTTP access.
TRUST_PROXY=1
AI_ALLOWED_HOSTS=

# Authoritative administrator credentials, synchronized on every start. Password minimum 12 characters.
# Change here, then apply deployment configuration. Existing admin sessions are revoked.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database: SQLite by default. PostgreSQL URL selects PostgreSQL.
DATABASE_PROVIDER=
DATABASE_URL=
# Used by ./love; sqlite, postgres (bundled), or external.
LOVE_DATABASE=sqlite
LOVE_HTTPS=1
# certbot: automatic issuance/renewal; caddy: Caddy automatic TLS; external: own reverse proxy.
# HTTP: LOVE_HTTPS=0, LOVE_TLS_PROVIDER=none, TRUST_PROXY=0.
LOVE_TLS_PROVIDER=certbot
# Public TLS listener; does not expose backend HTTP. Examples: 443 or 8013.
LOVE_TLS_PORT=443
LOVE_TLS_BIND_IP=0.0.0.0
CERTBOT_EMAIL=
POSTGRES_DB=love
POSTGRES_USER=love
POSTGRES_PASSWORD=

# Registration, invitation codes, SMTP, quotas and log retention belong to the admin UI.
