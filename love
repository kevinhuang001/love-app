#!/bin/sh
# One-time bridge for existing shell installations. New installs download the binary.
set -eu
umask 077
[ "$#" -eq 0 ] || { printf '直接运行 ./love，在菜单中选择操作。\n' >&2; exit 1; }
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
case "$(uname -m)" in
  x86_64) asset=love-linux-x64;;
  aarch64|arm64) asset=love-linux-arm64;;
  *) printf '支持 Linux amd64 / arm64。\n' >&2; exit 1;;
esac
command -v curl >/dev/null 2>&1 || { printf '请先安装 curl。\n' >&2; exit 1; }
command -v sha256sum >/dev/null 2>&1 || { printf '请先安装 coreutils。\n' >&2; exit 1; }
stage=$(mktemp -d "$PWD/.love-download.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT HUP INT TERM
base=https://github.com/kevinhuang001/love-app/releases/latest/download
printf '正在下载独立 Love 管理程序…\n'
curl -fL --retry 2 "$base/$asset" -o "$stage/$asset"
curl -fL --retry 2 "$base/SHA256SUMS" -o "$stage/SHA256SUMS"
grep "  $asset\$" "$stage/SHA256SUMS" > "$stage/check"
(cd "$stage" && sha256sum -c check)
chmod 755 "$stage/$asset"
mv -f -- "$stage/$asset" ./love
rm -rf -- "$stage"
trap - EXIT HUP INT TERM
exec ./love
