#!/bin/sh
# Interactive deployment manager. No build tools or host Node.js are required.
set -u
umask 077
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 1
[ "$#" -eq 0 ] || { printf '直接运行 ./love，在菜单中选择操作。\n' >&2; exit 1; }
command -v docker >/dev/null 2>&1 || { printf '请先安装 Docker Engine 和 Compose 插件。\n' >&2; exit 1; }
docker compose version >/dev/null || exit 1
work=''
ui_result=''
trap '[ -z "$work" ] || rm -rf -- "$work"; [ -z "$ui_result" ] || rm -f -- "$ui_result"' EXIT HUP INT TERM
setting() { [ ! -f .env ] || sed -n "s/^$1=['\"]\{0,1\}\([a-zA-Z0-9_./:@-]*\)['\"]\{0,1\}$/\1/p" .env | tail -1; }
reload() {
  image=$(setting LOVE_IMAGE); image=${image:-ghcr.io/kevinhuang001/love-app:latest}
  source=$(setting LOVE_IMAGE_SOURCE); source=${source:-release}
  database=$(setting LOVE_DATABASE); database=${database:-sqlite}
  https=$(setting LOVE_HTTPS); tls=$(setting LOVE_TLS_PROVIDER)
  project=$(setting COMPOSE_PROJECT_NAME); project=${project:-love-v4}
  case "$source" in release|registry) ;; *) printf '镜像来源无效，请选择镜像来源。\n' >&2; return 1;; esac
}
compose() {
  # Only fixed filenames enter the intentionally split argument list.
  files='-f compose.yml'
  [ "$database" != postgres ] || files="$files -f compose.postgres.yml"
  if [ "$https" = 1 ]; then
    case "$tls" in
      certbot) files="$files -f compose.https.yml -f compose.certbot.yml --profile https";;
      caddy) files="$files -f compose.https.yml --profile https";;
      external) ;; *) printf 'HTTPS 方式无效，请重新配置。\n' >&2; return 1;;
    esac
  fi
  docker compose --project-name "$project" --env-file .env $files "$@"
}
ui() {
  ui_status=1
  ensure_image || return 1
  ui_result=$(mktemp "$PWD/.love-ui.XXXXXXXX") || return 1
  tty_flag=-i
  if [ -t 0 ] && [ -t 1 ]; then tty_flag=-it; fi
  docker run --rm "$tty_flag" --user "$(id -u):$(id -g)" -e LOVE_UI_IMAGE="$image" -v "$PWD:/setup" --entrypoint node "$image" /setup/deploy/terminal-ui.mjs "$1" "/setup/$(basename "$ui_result")" "${2:-}" "${3:-}"
  ui_status=$?
  answer=$(cat "$ui_result")
  rm -f -- "$ui_result"; ui_result=''
  return "$ui_status"
}
confirm() { ui confirm "$1" && [ "$answer" = yes ]; }
set_field() {
  # Values passed here are restricted image references / fixed enum fields.
  [ -f .env ] || return 0
  sed "/^$1=/d" .env > .env.next && printf "%s='%s'\n" "$1" "$2" >> .env.next && chmod 600 .env.next && mv .env.next .env
}
get_asset() {
  command -v curl >/dev/null 2>&1 || { printf '下载需要 curl，请先安装。\n' >&2; return 1; }
  [ -n "$work" ] || work=$(mktemp -d "${TMPDIR:-/tmp}/love-download.XXXXXXXX") || return 1
  asset=$1
  base=https://github.com/kevinhuang001/love-app/releases/download/docker-latest
  curl --fail --location --retry 3 --connect-timeout 20 --max-time 1800 "$base/$asset" -o "$work/$asset" || return 1
  [ -f "$work/SHA256SUMS" ] || curl --fail --location --retry 3 --connect-timeout 20 --max-time 120 "$base/SHA256SUMS" -o "$work/SHA256SUMS" || return 1
  expected=$(awk -v name="$asset" '$2==name {print $1}' "$work/SHA256SUMS")
  [ "${#expected}" -eq 64 ] || { printf '发布校验清单缺少 %s，稍后重试。\n' "$asset" >&2; return 1; }
  if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$work/$asset" | cut -d ' ' -f 1)
  elif command -v shasum >/dev/null 2>&1; then actual=$(shasum -a 256 "$work/$asset" | cut -d ' ' -f 1)
  else printf '请安装 sha256sum 或 shasum。\n' >&2; return 1; fi
  [ "$actual" = "$expected" ] || { printf '下载校验失败，未导入或安装。发布可能正在更新，请稍后重试。\n' >&2; return 1; }
}
download_image() {
  if [ "$source" = registry ]; then docker pull "$image" || return 1
  else
    case "$(uname -m)" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) printf '只提供 Linux amd64 / arm64 镜像。\n' >&2; return 1;; esac
    get_asset "Love-docker-$arch.tar.gz" || return 1
    docker load -i "$work/Love-docker-$arch.tar.gz" || return 1
    image=love-app:prebuilt
    set_field LOVE_IMAGE "$image" || return 1
  fi
}
ensure_image() { docker image inspect "$image" >/dev/null 2>&1 || download_image; }
choose_source() {
  ui source || return 1
  case "$answer" in
    release) source=release; image=love-app:prebuilt;;
    ghcr) source=registry; image=ghcr.io/kevinhuang001/love-app:latest;;
    custom) ui image || return 1; image=$answer; source=registry;
       case "$image" in ''|*[!a-zA-Z0-9_./:@-]*) printf '镜像地址无效。\n' >&2; return 1;; esac;;
    *) return 0;;
  esac
  download_image || return 1
  set_field LOVE_IMAGE_SOURCE "$source" && set_field LOVE_IMAGE "$image"
}
configure() {
  [ -t 0 ] && [ -t 1 ] || { printf '配置需要交互终端。\n' >&2; return 1; }
  ensure_image || return 1
  docker run --rm -it --user "$(id -u):$(id -g)" -e LOVE_IMAGE="$image" -e LOVE_IMAGE_SOURCE="$source" -v "$PWD:/setup" --entrypoint node "$image" /app/scripts/setup.mjs --output /setup/.env || return 1
  reload || return 1
  printf '部署配置已保存。账号、邀请码和 SMTP 的现有设置请在“服务器管理”菜单管理。\n'
  confirm '立即应用配置并启动？' && start || return 0
}
require_config() { [ -f .env ] || configure; [ -f .env ]; }
start() {
  require_config && ensure_image || return 1
  if [ "$https" != 1 ] || [ "$tls" = external ]; then compose --profile https stop proxy >/dev/null 2>&1 || true; fi
  compose up -d --no-build --pull missing --remove-orphans --wait
}
backup() {
  require_config || return 1
  ensure_image || return 1
  backup_dir="$PWD/backups/$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$backup_dir" || return 1
  running=$(compose ps --status running -q love) || return 1
  [ "$database" != postgres ] || compose up -d --no-build --wait postgres || return 1
  compose stop love || return 1
  cp .env "$backup_dir/deployment.env" || { [ -z "$running" ] || compose start love; return 1; }
  if ! docker run --rm --user 0 --mount "type=volume,src=${project}_love-data,dst=/data,readonly" --entrypoint tar "$image" -C /data -czf - . > "$backup_dir/data.tar.gz"; then
    [ -z "$running" ] || compose start love; return 1
  fi
  if [ "$database" != sqlite ] && ! compose --profile management run --rm -T --no-deps database-tools sh -c 'exec pg_dump --format=custom' > "$backup_dir/database.dump"; then
    [ -z "$running" ] || compose start love; return 1
  fi
  (cd "$backup_dir" && { if command -v sha256sum >/dev/null 2>&1; then sha256sum deployment.env data.tar.gz; [ ! -f database.dump ] || sha256sum database.dump; else shasum -a 256 deployment.env data.tar.gz; [ ! -f database.dump ] || shasum -a 256 database.dump; fi; } > SHA256SUMS) || { [ -z "$running" ] || compose start love; return 1; }
  [ -z "$running" ] || compose start love || return 1
  printf '备份完成：%s（包含密码和密钥，请妥善保管）。\n' "$backup_dir"
}
restore() {
  require_config || return 1
  ui backup || return 1
  name=$answer
  case "$name" in ''|*[!a-zA-Z0-9_-]*) return 0;; esac
  restore_dir="$PWD/backups/$name"
  [ -f "$restore_dir/SHA256SUMS" ] && [ -f "$restore_dir/deployment.env" ] || { printf '备份不存在或不完整。\n' >&2; return 1; }
  (cd "$restore_dir" && { if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi; }) || return 1
  saved_project=$(sed -n "s/^COMPOSE_PROJECT_NAME=['\"]\{0,1\}\([a-zA-Z0-9_.-]*\)['\"]\{0,1\}$/\1/p" "$restore_dir/deployment.env" | tail -1); saved_project=${saved_project:-love-v4}
  [ "$saved_project" = "$project" ] || { printf '备份属于其他部署，未覆盖当前数据。\n' >&2; return 1; }
  saved_database=$(sed -n "s/^LOVE_DATABASE=['\"]\{0,1\}\([a-z]*\)['\"]\{0,1\}$/\1/p" "$restore_dir/deployment.env"); saved_database=${saved_database:-sqlite}
  [ "$saved_database" = "$database" ] || { printf '数据库类型不匹配，未覆盖当前数据。\n' >&2; return 1; }
  ui text '这会覆盖当前数据和部署配置。输入 RESTORE 确认' RESTORE || return 1
  [ "$answer" = RESTORE ] || return 0
  backup || return 1
  compose stop love || return 1
  if [ "$database" != sqlite ]; then
    compose --profile management run --rm -T --no-deps database-tools sh -c 'exec pg_restore --dbname="$PGDATABASE" --clean --if-exists --no-owner --exit-on-error' < "$restore_dir/database.dump" || return 1
  fi
  docker run --rm --user 0 -i --mount "type=volume,src=${project}_love-data,dst=/data" --entrypoint sh "$image" -c 'find /data -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && tar -C /data -xzf - && chown -R node:node /data' < "$restore_dir/data.tar.gz" || return 1
  cp "$restore_dir/deployment.env" .env && chmod 600 .env && reload && start
}
update() {
  require_config || return 1
  confirm '下载最新软件和管理工具，并在备份后更新？' || return 0
  backup || return 1
  [ -z "$work" ] || { rm -rf -- "$work"; work=''; }
  get_asset Love-docker-deploy.tar.gz || return 1
  mkdir "$work/deploy" || return 1
  # The checksum comes from the same HTTPS release. Install only known deployment files.
  tar --no-same-owner --no-same-permissions -xzf "$work/Love-docker-deploy.tar.gz" -C "$work/deploy" || return 1
  for file in love compose.yml compose.postgres.yml compose.https.yml compose.certbot.yml Caddyfile deploy/terminal-ui.mjs; do
    [ -f "$work/deploy/$file" ] && [ ! -L "$work/deploy/$file" ] || { printf '部署包不完整，未更新。\n' >&2; return 1; }
  done
  rollback_image="love-app:rollback-$(date -u +%Y%m%dT%H%M%SZ)"
  docker tag "$image" "$rollback_image" || return 1
  download_image || return 1
  printf '%s\n' "$rollback_image" > .love-rollback
  for file in love compose.yml compose.postgres.yml compose.https.yml compose.certbot.yml Caddyfile; do
    cp "$work/deploy/$file" "$file.next" && mv "$file.next" "$file" || return 1
  done
  cp -R "$work/deploy/deploy" . || return 1
  chmod 755 love
  start || { printf '启动失败，可从菜单选择回滚；备份已保留。\n' >&2; return 1; }
  printf '更新完成，正在重新加载管理菜单。\n'
  rm -rf -- "$work"; work=''
  exec sh ./love
}
rollback() {
  [ -f .love-rollback ] || { printf '没有可用的上次更新镜像。\n' >&2; return 1; }
  rollback_image=$(cat .love-rollback)
  case "$rollback_image" in love-app:rollback-*[!a-zA-Z0-9_-]*|'') printf '回滚记录无效。\n' >&2; return 1;; love-app:rollback-*) ;; *) return 1;; esac
  confirm '使用上次更新前的镜像？部署配置和数据不回滚。' || return 0
  docker image inspect "$rollback_image" >/dev/null || return 1
  image=$rollback_image; set_field LOVE_IMAGE "$image" && start
}
manage_server() {
  require_config && ensure_image || return 1
  running=$(compose ps --status running -q love) || return 1
  compose stop love || return 1
  compose run --rm --no-deps --interactive --tty --entrypoint node love /app/scripts/manage-server.mjs
  result=$?
  [ -z "$running" ] || compose start love || return 1
  return "$result"
}
uninstall() {
  require_config || return 1
  ui uninstall "$project" || return 1
  case "$answer" in
    containers) confirm '移除当前部署的容器？' && compose --profile https down --remove-orphans || return 0;;
    volumes) ui text '仅删除当前部署的数据卷，备份不删除。输入确认文字' "DELETE-$project" || return 1
       [ "$answer" = "DELETE-$project" ] || return 0
       compose --profile https down --volumes --remove-orphans || return 1;;
    *) return 0;;
  esac
}
if [ ! -f compose.yml ]; then
  printf '正在下载并校验部署配置包…\n'
  get_asset Love-docker-deploy.tar.gz || exit 1
  tar --no-same-owner --no-same-permissions -xzf "$work/Love-docker-deploy.tar.gz" -C "$PWD" || exit 1
  chmod +x love
  rm -rf -- "$work"; work=''
  exec sh ./love
fi
while :; do
  reload || true
  ui menu || { [ "$ui_status" = 130 ] && exit 0; exit 1; }
  choice=$answer
  result=0
  case "$choice" in
    configure) configure || result=$?;;
    start) start || result=$?;;
    stop) require_config && compose --profile https stop || result=$?;;
    restart) require_config && compose restart || result=$?;;
    status) require_config && compose ps && docker image inspect "$image" --format '{{.Id}} {{.Created}}' || result=$?;;
    logs) require_config && compose logs --tail 200 || result=$?;;
    update) update || result=$?;;
    backup) backup || result=$?;;
    restore) restore || result=$?;;
    manage) manage_server || result=$?;;
    source) choose_source || result=$?;;
    uninstall) uninstall || result=$?;;
    rollback) rollback || result=$?;;
    exit) exit 0;;
    *) exit 1;;
  esac
  [ "$result" = 0 ] || printf '操作未完成（退出码 %s），配置和备份仍保留。\n' "$result" >&2
  [ -z "$work" ] || { rm -rf -- "$work"; work=''; }
done
