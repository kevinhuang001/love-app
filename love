#!/bin/sh
# Interactive deployment manager. No build tools or host Node.js are required.
set -u
umask 077
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 1
[ "$#" -eq 0 ] || { printf '直接运行 ./love，在菜单中选择操作。\n' >&2; exit 1; }
command -v docker >/dev/null 2>&1 || { printf '请先安装 Docker Engine 和 Compose 插件。\n' >&2; exit 1; }
docker compose version >/dev/null || exit 1
work=''
ui_result=''
trap '[ -z "$work" ] || rm -rf -- "$work"; [ -z "$ui_result" ] || rm -f -- "$ui_result"' EXIT HUP INT TERM
refresh_screen() {
  if [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
    printf '\033[H\033[2J\033[3J'
  fi
}
setting() { [ ! -f .env ] || sed -n "s/^$1=['\"]\{0,1\}\([a-zA-Z0-9_./:@-]*\)['\"]\{0,1\}$/\1/p" .env | tail -1; }
reload() {
  image=$(setting LOVE_IMAGE); image=${image:-ghcr.io/kevinhuang001/love-app:latest}
  database=$(setting LOVE_DATABASE); database=${database:-sqlite}
  https=$(setting LOVE_HTTPS); tls=$(setting LOVE_TLS_PROVIDER)
  project=$(setting COMPOSE_PROJECT_NAME); project=${project:-love-v4}
  data_volume=$(setting LOVE_DATA_VOLUME); data_volume=${data_volume:-love-data}
  case "$data_volume" in love-data|postgres-work) ;; *) printf '应用数据卷配置无效。\n' >&2; return 1;; esac
  case "$image" in ghcr.io/kevinhuang001/love-app:*|ghcr.io/kevinhuang001/love-app@sha256:*) ;; *) image=ghcr.io/kevinhuang001/love-app:latest;; esac
}
compose() {
  # Only fixed filenames enter the intentionally split argument list.
  files='-f compose.yml'
  [ "$database" != postgres ] || files="$files -f compose.postgres.yml"
  [ "$data_volume" != postgres-work ] || files="$files -f compose.storage.yml"
  if [ "$https" = 1 ]; then
    case "$tls" in
      certbot) files="$files -f compose.https.yml -f compose.certbot.yml --profile https";;
      caddy) files="$files -f compose.https.yml --profile https";;
      external) ;; *) printf 'HTTPS 方式无效，请重新配置。\n' >&2; return 1;;
    esac
  fi
  docker compose --project-name "$project" --env-file "${compose_env:-.env}" $files "$@"
}
running_app_containers() {
  docker ps --quiet --no-trunc \
    --filter "label=com.docker.compose.project=$project" \
    --filter 'label=com.docker.compose.service=love' \
    --filter 'label=com.docker.compose.oneoff=False'
}
ui() {
  ui_status=1
  ensure_image || return 1
  ui_result=$(mktemp "$PWD/.love-ui.XXXXXXXX") || return 1
  tty_flag=-i
  if [ -t 0 ] && [ -t 1 ]; then tty_flag=-it; fi
  docker run --rm "$tty_flag" --user "$(id -u):$(id -g)" -e LOVE_UI_IMAGE="$image" -v "$PWD:/setup" --entrypoint node "$image" /setup/deploy/terminal-ui.mjs "$1" "/setup/$(basename "$ui_result")" "${2:-}" "${3:-}"
  ui_status=$?
  answer=$(cat "$ui_result")
  rm -f -- "$ui_result"; ui_result=''
  return "$ui_status"
}
confirm() { ui confirm "$1" && [ "$answer" = yes ]; }
return_to_menu() { ui continue || { [ "$ui_status" = 130 ] && exit 0; exit 1; }; }
install_file() (
  # A unique file beside the destination avoids stale .next files and symlinks.
  source_file=$1; target_file=$2; target_mode=${3:-600}
  staged_file=$(mktemp "$(dirname -- "$target_file")/.love-$(basename -- "$target_file").XXXXXXXX") || return 1
  trap 'rm -f -- "$staged_file"' EXIT
  trap 'exit 1' HUP INT TERM
  cp -- "$source_file" "$staged_file" && chmod "$target_mode" "$staged_file" && mv -fT -- "$staged_file" "$target_file"
)
set_field() (
  # Values passed here are restricted image references / fixed enum fields.
  [ -f .env ] || return 0
  [ "$(setting "$1")" != "$2" ] || return 0
  staged_env=$(mktemp "$PWD/.love-env.XXXXXXXX") || return 1
  trap 'rm -f -- "$staged_env"' EXIT
  trap 'exit 1' HUP INT TERM
  sed "/^$1=/d" .env > "$staged_env" && printf "%s='%s'\n" "$1" "$2" >> "$staged_env" && mv -fT -- "$staged_env" .env
)
download_image() { docker pull "$image"; }
ensure_image() { docker image inspect "$image" >/dev/null 2>&1 || download_image; }
deployment_bundle() {
  [ -n "$work" ] || work=$(mktemp -d "${TMPDIR:-/tmp}/love-deploy.XXXXXXXX") || return 1
  mkdir -p "$work/deploy" || return 1
  docker run --rm --entrypoint tar "$image" -C /app -cf - love compose.yml compose.postgres.yml compose.https.yml compose.certbot.yml compose.storage.yml deploy Caddyfile > "$work/deploy.tar" || return 1
  tar --no-same-owner --no-same-permissions -xf "$work/deploy.tar" -C "$work/deploy" || return 1
  for file in love compose.yml compose.postgres.yml compose.https.yml compose.certbot.yml compose.storage.yml Caddyfile deploy/terminal-ui.mjs deploy/certbot-proxy.sh deploy/certbot-renew.sh; do
    [ -f "$work/deploy/$file" ] && [ ! -L "$work/deploy/$file" ] || { printf '镜像部署配置不完整。\n' >&2; return 1; }
  done
}
install_bundle() {
  mkdir -p deploy || return 1
  for file in compose.yml compose.postgres.yml compose.https.yml compose.certbot.yml compose.storage.yml Caddyfile deploy/terminal-ui.mjs deploy/certbot-proxy.sh deploy/certbot-renew.sh love; do
    mode=600; [ "$file" != love ] || mode=755
    install_file "$work/deploy/$file" "$file" "$mode" || return 1
  done
}
update_tools() {
  for file in deploy/terminal-ui.mjs deploy/certbot-proxy.sh compose.storage.yml Caddyfile love; do
    [ ! -d "$file" ] || { printf '部署文件路径被目录占用：%s\n' "$file" >&2; return 1; }
  done
  for file in deploy/terminal-ui.mjs deploy/certbot-proxy.sh compose.storage.yml Caddyfile love; do
    mode=600; [ "$file" != love ] || mode=755
    install_file "$work/deploy/$file" "$file" "$mode" || return 1
  done
}
configure() {
  [ -t 0 ] && [ -t 1 ] || { printf '配置需要交互终端。\n' >&2; return 1; }
  ensure_image || return 1
  docker run --rm -it --user "$(id -u):$(id -g)" -e LOVE_IMAGE="$image" -v "$PWD:/setup" --entrypoint node "$image" /app/scripts/setup.mjs --output /setup/.env || return 1
  reload || return 1
  printf '部署配置已保存。管理员凭据以 .env 为准；注册、邀请码、SMTP 和容量请登录后台管理。\n'
  confirm '立即应用配置并启动？' && start || return 0
}
require_config() { [ -f .env ] || configure; [ -f .env ]; }
start() {
  require_config && ensure_image || return 1
  set_field LOVE_IMAGE "$image" || return 1
  if [ "$https" != 1 ] || [ "$tls" = external ]; then compose --profile https stop proxy >/dev/null 2>&1 || true; fi
  compose up -d --no-build --pull missing --remove-orphans --wait
}
backup() {
  require_config && ensure_image || return 1
  backup_dir=$(mktemp -d "$PWD/backups/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXXXX" 2>/dev/null) || {
    mkdir -p "$PWD/backups" || return 1
    backup_dir=$(mktemp -d "$PWD/backups/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXXXX") || return 1
  }
  backup_image=$image
  if ! docker run --rm --entrypoint sh "$backup_image" -c 'test -f /app/apps/server/dist/database-backup-cli.js'; then
    printf '正在获取统一备份工具镜像…\n'
    backup_image=ghcr.io/kevinhuang001/love-app:latest
    docker pull "$backup_image" || return 1
  fi
  running=$(running_app_containers) || return 1
  [ "$database" != postgres ] || compose up -d --no-build --wait postgres || return 1
  compose stop love || return 1
  cp .env "$backup_dir/deployment.env" || { [ -z "$running" ] || compose start love; return 1; }
  if ! LOVE_IMAGE="$backup_image" compose run --rm -T --no-deps --user 0 --entrypoint node love /app/apps/server/dist/database-backup-cli.js backup > "$backup_dir/data.tar.gz"; then
    [ -z "$running" ] || compose start love; return 1
  fi
  (cd "$backup_dir" && { if command -v sha256sum >/dev/null 2>&1; then sha256sum deployment.env data.tar.gz; else shasum -a 256 deployment.env data.tar.gz; fi; } > SHA256SUMS) || { [ -z "$running" ] || compose start love; return 1; }
  [ -z "$running" ] || compose start love || return 1
  printf '备份完成：%s（统一数据包，包含密码和密钥，请妥善保管）。\n' "$backup_dir"
}
optional_backup() {
  backup_dir=''
  ui backup-policy || return 1
  case "$answer" in
    backup) backup || return 1;;
    skip) printf '已跳过操作前备份。\n';;
    *) return 1;;
  esac
}
# Old PGDMP archives can only be decoded by PostgreSQL. Use an isolated, disposable
# reader on a private network: never restore a native dump into the production DB.
convert_legacy_backup() (
  reader="love-backup-reader-$$"
  network="$reader-net"
  trap 'docker rm -fv "$reader" >/dev/null 2>&1 || true; docker network rm "$network" >/dev/null 2>&1 || true' EXIT
  trap 'exit 1' HUP INT TERM
  printf '读取旧版 PostgreSQL 备份：启动隔离的临时读取容器，完成后删除；当前外部数据库配置不变。\n' >&2
  docker network create "$network" >/dev/null || exit 1
  docker run -d --name "$reader" --network "$network" -e POSTGRES_PASSWORD=backup-reader-private-network --mount "type=bind,src=$restore_dir,dst=/backup,readonly" postgres:18-alpine >/dev/null || exit 1
  docker exec "$reader" sh -c 'i=0; until pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1; do i=$((i+1)); [ "$i" -lt 60 ] || exit 1; sleep 1; done' || exit 1
  docker exec -e PGPASSWORD=backup-reader-private-network "$reader" pg_restore --host=127.0.0.1 --clean --if-exists --dbname=postgres --username=postgres --no-owner --no-privileges --exit-on-error --single-transaction /backup/database.dump || exit 1
  docker run --rm --network "$network" --user 0 --mount "type=bind,src=$restore_dir,dst=/backup,readonly" -e DATABASE_PROVIDER=postgres -e PGHOST="$reader" -e PGPORT=5432 -e PGDATABASE=postgres -e PGUSER=postgres -e PGPASSWORD=backup-reader-private-network --entrypoint node "$image" /app/apps/server/dist/database-backup-cli.js legacy-export --directory /backup > "$work/data.tar.gz" || exit 1
)
inspect_restore_package() {
  restore_format=$(docker run --rm --user 0 --mount "type=bind,src=$restore_dir,dst=/backup,readonly" --entrypoint node "$image" /app/apps/server/dist/database-backup-cli.js inspect --directory /backup)
  inspect_status=$?
  case "$inspect_status" in 0|2) ;; *) return 1;; esac
  case "$restore_format" in sqlite|postgres|legacy-postgres) ;; *) printf '无法识别备份类型。\n' >&2; return 1;; esac
  credential_reset_flag=''
  if [ "$inspect_status" = 2 ]; then
    ui recovery-policy || return 1
    [ "$answer" = recover ] || return 1
    credential_reset_flag=--reset-unreadable-credentials
  fi
}
restore() {
  require_config && ensure_image || return 1
  ui backup || return 1
  name=$answer
  case "$name" in ''|*[!a-zA-Z0-9_-]*) return 0;; esac
  restore_dir="$PWD/backups/$name"
  [ -d "$restore_dir" ] && [ ! -L "$restore_dir" ] || { printf '备份目录不存在或无效。\n' >&2; return 1; }
  inspect_restore_package || return 1
  ui text '将备份数据导入当前数据库，保留当前部署配置。输入 RESTORE 确认' RESTORE || return 1
  [ "$answer" = RESTORE ] || return 0
  if [ "$restore_format" = legacy-postgres ]; then
    [ -z "$work" ] || rm -rf -- "$work"
    work=$(mktemp -d "$PWD/.love-restore.XXXXXXXX") || return 1
    convert_legacy_backup || return 1
    cp "$restore_dir/deployment.env" "$work/deployment.env" || return 1
    (cd "$work" && { if command -v sha256sum >/dev/null 2>&1; then sha256sum deployment.env data.tar.gz; else shasum -a 256 deployment.env data.tar.gz; fi; } > SHA256SUMS) || return 1
    restore_dir=$work
    inspect_restore_package || return 1
  fi
  optional_backup || return 1
  restore_running=$(running_app_containers) || return 1
  [ "$database" != postgres ] || compose up -d --no-build --wait postgres || return 1
  compose stop love || return 1
  # This optional argument is a fixed flag set only by the explicit recovery confirmation.
  if ! compose run --rm -T --no-deps --user 0 --volume "$restore_dir:/backup:ro" --entrypoint node love /app/apps/server/dist/database-backup-cli.js restore --directory /backup $credential_reset_flag; then
    printf '恢复失败；当前数据和部署配置保留。\n' >&2
    [ -z "$restore_running" ] || compose start love
    return 1
  fi
  # Recreated containers pick up the same current .env, never deployment.env from the backup.
  start || { printf '数据已恢复，启动失败；请检查连接和日志。恢复前备份：%s\n' "${backup_dir:-未创建}" >&2; return 1; }
  printf '恢复完成，当前数据库与部署配置保持不变。\n'
}
update() {
  require_config && ensure_image || return 1
  printf '正在检查 GHCR 更新…\n'
  running=$(running_app_containers) || return 1
  current_id=''
  # docker ps may return several IDs. Inspect each separately, never a quoted
  # multiline argument. All application instances must use the same image.
  for container_id in $running; do
    container_image=$(docker container inspect "$container_id" --format '{{.Image}}') || return 1
    if [ -n "$current_id" ] && [ "$current_id" != "$container_image" ]; then
      printf '当前部署有多个运行实例使用不同镜像，无法安全确定更新版本；请先在状态页检查实例。\n' >&2
      return 1
    fi
    current_id=$container_image
  done
  [ -n "$current_id" ] || current_id=$(docker image inspect "$image" --format '{{.Id}}') || return 1
  latest=$(docker run --rm -i --entrypoint node "$image" --input-type=module - "$current_id" <<'GHCR_CHECK'
// Read registry metadata without pulling layers or stopping the running application.
const repository = 'kevinhuang001/love-app';
export async function checkUpdate(currentId, { request = fetch, arch = process.arch } = {}) {
  const get = async (url, headers = {}) => {
    const response = await request(url, { headers, signal: AbortSignal.timeout(20_000) });
    if (!response.ok) throw new Error(`GHCR 更新检查失败 (${response.status})`);
    return response;
  };
  const token = (
    await (
      await get(`https://ghcr.io/token?service=ghcr.io&scope=repository:${repository}:pull`)
    ).json()
  ).token;
  if (!token) throw new Error('GHCR 未提供拉取凭据，请确认官方镜像公开可访问');
  const headers = {
    Authorization: `Bearer ${token}`,
    Accept:
      'application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json',
  };
  const root = await get(`https://ghcr.io/v2/${repository}/manifests/latest`, headers);
  const digest = root.headers.get('docker-content-digest');
  if (!/^sha256:[a-f0-9]{64}$/.test(digest || '')) throw new Error('GHCR 镜像校验摘要无效');
  let manifest = await root.json();
  if (manifest.manifests) {
    const architecture = arch === 'x64' ? 'amd64' : arch === 'arm64' ? 'arm64' : arch;
    const platform = manifest.manifests.find(
      (entry) => entry.platform?.os === 'linux' && entry.platform.architecture === architecture,
    );
    if (!platform || !/^sha256:[a-f0-9]{64}$/.test(platform.digest))
      throw new Error('GHCR 未提供当前设备架构的镜像');
    manifest = await (
      await get(`https://ghcr.io/v2/${repository}/manifests/${platform.digest}`, headers)
    ).json();
  }
  if (!/^sha256:[a-f0-9]{64}$/.test(manifest.config?.digest || ''))
    throw new Error('GHCR 镜像配置摘要无效');
  return manifest.config.digest === currentId ? '' : `ghcr.io/${repository}@${digest}`;
}
if (process.argv[1] === '-') {
  try {
    const image = await checkUpdate(process.argv[2]);
    if (image) console.log(image);
  } catch (error) {
    console.error(error.message);
    process.exitCode = 1;
  }
}
GHCR_CHECK
  ) || return 1
  [ -n "$latest" ] || { printf '已是最新版本，无需更新。\n'; return 0; }
  case "$latest" in ghcr.io/kevinhuang001/love-app@sha256:*) ;; *) printf '更新检查结果无效。\n' >&2; return 1;; esac
  confirm '发现新版本。下载 GHCR 镜像并更新？' || return 0
  optional_backup || return 1
  rollback_image="ghcr.io/kevinhuang001/love-app:rollback-$(date -u +%Y%m%dT%H%M%SZ)"
  docker tag "$current_id" "$rollback_image" || return 1
  previous_image=$image
  image=$latest
  download_image || { image=$previous_image; return 1; }
  deployment_bundle || { image=$previous_image; return 1; }
  # Proxy templates are bundled application code. Deployment values stay in .env.
  update_tools || { image=$previous_image; return 1; }
  printf '%s\n' "$rollback_image" > .love-rollback
  set_field LOVE_IMAGE "$image" || return 1
  start || { printf '启动失败，可检查日志或从菜单选择回滚。\n' >&2; return 1; }
  if [ "$https" = 1 ] && [ "$tls" != external ]; then compose restart proxy || return 1; fi
  printf '更新完成，正在重新加载管理菜单。\n'
  return_to_menu
  rm -rf -- "$work"; work=''
  exec sh ./love
}
rollback() {
  [ -f .love-rollback ] || { printf '没有可用的上次更新镜像。\n' >&2; return 1; }
  rollback_image=$(cat .love-rollback)
  case "$rollback_image" in ghcr.io/kevinhuang001/love-app:rollback-*[!a-zA-Z0-9_-]*|'') printf '回滚记录无效。\n' >&2; return 1;; ghcr.io/kevinhuang001/love-app:rollback-*) ;; *) return 1;; esac
  confirm '使用上次更新前的镜像？部署配置和数据不回滚。' || return 0
  docker image inspect "$rollback_image" >/dev/null || return 1
  image=$rollback_image; set_field LOVE_IMAGE "$image" && start
}
cleanup_media() {
  require_config && ensure_image || return 1
  confirm '暂停写入并预览未使用媒体？保护回忆、聊天和头像；所有未发布上传均纳入清理。' || return 0
  optional_backup || return 1
  cleanup_running=$(running_app_containers) || return 1
  compose stop love || return 1
  cleanup_status=0
  cleanup_review=$(compose run --rm -T --no-deps --user 0 --entrypoint node love /app/apps/server/dist/unused-media-cli.js) || cleanup_status=$?
  if [ "$cleanup_status" = 0 ] && confirm '永久删除以上清单中的未使用媒体和临时文件？既有备份不变。'; then
    compose run --rm -T --no-deps --user 0 --entrypoint node love /app/apps/server/dist/unused-media-cli.js --apply --review "$cleanup_review" || cleanup_status=$?
  fi
  [ -z "$cleanup_running" ] || compose start love || cleanup_status=1
  return "$cleanup_status"
}
check_database() {
  require_config && ensure_image || return 1
  ui check-mode || return 1
  case "$answer" in
    cancel) return 0;;
    quick) check_flag='';;
    deep) check_flag='--deep';;
    *) return 1;;
  esac
  check_running=$(running_app_containers) || return 1
  compose stop love || return 1
  check_status=0
  compose run --rm -T --no-deps --user 0 --entrypoint node love /app/apps/server/dist/database-check-cli.js $check_flag || check_status=$?
  [ -z "$check_running" ] || compose start love || check_status=1
  return "$check_status"
}
database_menu() {
  while :; do
    refresh_screen
    ui database-menu || { [ "$ui_status" = 130 ] && return 0; return 1; }
    database_choice=$answer
    [ "$database_choice" != back ] || return 0
    refresh_screen
    database_result=0
    case "$database_choice" in
      check) check_database || database_result=$?;;
      backup) backup || database_result=$?;;
      restore) restore || database_result=$?;;
      cleanup) cleanup_media || database_result=$?;;
      *) return 1;;
    esac
    [ "$database_result" = 0 ] || printf '操作未完成（退出码 %s），配置和备份仍保留。\n' "$database_result" >&2
    [ -z "$work" ] || { rm -rf -- "$work"; work=''; }
    ui continue '返回数据库管理' || return 1
  done
}

uninstall() {
  require_config || return 1
  ui uninstall "$project" || return 1
  case "$answer" in
    containers) confirm '移除当前部署的容器？' && compose --profile https down --remove-orphans || return 0;;
    volumes) ui text '仅删除当前部署的数据卷，备份不删除。输入确认文字' "DELETE-$project" || return 1
       [ "$answer" = "DELETE-$project" ] || return 0
       compose --profile https down --volumes --remove-orphans || return 1;;
    *) return 0;;
  esac
}
if [ ! -f compose.yml ]; then
  image=ghcr.io/kevinhuang001/love-app:latest
  printf '正在从 GHCR 获取部署工具…\n'
  ensure_image && deployment_bundle && install_bundle || exit 1
  rm -rf -- "$work"; work=''
  exec sh ./love
fi
while :; do
  reload || true
  refresh_screen
  ui menu || { [ "$ui_status" = 130 ] && exit 0; exit 1; }
  choice=$answer
  case "$choice" in
    refresh) continue;;
    exit) exit 0;;
  esac
  refresh_screen
  result=0
  case "$choice" in
    configure) configure || result=$?;;
    start) start || result=$?;;
    stop) require_config && compose --profile https stop || result=$?;;
    restart) require_config && compose restart || result=$?;;
    status) require_config && compose ps && docker image inspect "$image" --format '{{.Id}} {{.Created}}' || result=$?;;
    logs) require_config && compose logs --tail 200 || result=$?;;
    update) update || result=$?;;
    database) database_menu || result=$?;;
    uninstall) uninstall || result=$?;;
    rollback) rollback || result=$?;;
    *) exit 1;;
  esac
  [ "$choice" != database ] || { [ "$result" != 0 ] || continue; }
  [ "$result" = 0 ] || printf '操作未完成（退出码 %s），配置和备份仍保留。\n' "$result" >&2
  [ -z "$work" ] || { rm -rf -- "$work"; work=''; }
  return_to_menu
done
