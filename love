#!/bin/sh
# Docker-only launcher: configure once, then start with the selected Compose files.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
command -v docker >/dev/null 2>&1 || { echo '请先安装 Docker Engine 和 Compose 插件。' >&2; exit 1; }
docker compose version >/dev/null
mode=${1:-up}
case "$mode" in up|setup|down|logs|ps) ;; *) echo '用法：./love [up|setup|down|logs|ps]' >&2; exit 1 ;; esac
# Read only fixed enum fields, never evaluate/shell-source secret values from .env.
setting() { [ ! -f .env ] || sed -n "s/^$1=['\"]\{0,1\}\([a-zA-Z0-9_.-]*\)['\"]\{0,1\}$/\1/p" .env | tail -1; }
LOVE_DOCKERFILE=${LOVE_DOCKERFILE:-$(setting LOVE_DOCKERFILE)}
LOVE_DOCKERFILE=${LOVE_DOCKERFILE:-Dockerfile}
case "$LOVE_DOCKERFILE" in Dockerfile|Dockerfile.cn) ;; *) echo 'LOVE_DOCKERFILE 只能为 Dockerfile 或 Dockerfile.cn。' >&2; exit 1 ;; esac
export LOVE_DOCKERFILE
image_setting() { [ ! -f .env ] || sed -n "s/^LOVE_IMAGE=['\"]\{0,1\}\([a-zA-Z0-9_./:@-]*\)['\"]\{0,1\}$/\1/p" .env | tail -1; }
LOVE_IMAGE=${LOVE_IMAGE:-$(image_setting)}
LOVE_IMAGE=${LOVE_IMAGE:-love-app:local}
LOVE_IMAGE_PULL=${LOVE_IMAGE_PULL:-$(setting LOVE_IMAGE_PULL)}
LOVE_IMAGE_PULL=${LOVE_IMAGE_PULL:-1}
case "$LOVE_IMAGE_PULL" in 0|1) ;; *) echo 'LOVE_IMAGE_PULL 只能为 0 或 1。' >&2; exit 1 ;; esac
export LOVE_IMAGE LOVE_IMAGE_PULL
image_ready=0
prepare_image() {
  [ "$image_ready" = 0 ] || return 0
  if [ "$LOVE_IMAGE" = love-app:local ]; then
    docker build -f "$LOVE_DOCKERFILE" -t "$LOVE_IMAGE" .
  elif [ "$LOVE_IMAGE_PULL" = 1 ]; then
    docker pull "$LOVE_IMAGE"
  else
    docker image inspect "$LOVE_IMAGE" >/dev/null || { echo '预构建镜像不存在，请先运行 docker load。' >&2; exit 1; }
  fi
  image_ready=1
}
if [ "$mode" = setup ] || { [ "$mode" = up ] && [ ! -f .env ]; }; then
  [ -t 0 ] && [ -t 1 ] || { echo '首次部署需要交互终端，请运行 ./love setup。' >&2; exit 1; }
  prepare_image
  docker run --rm -it --user "$(id -u):$(id -g)" -e LOVE_DOCKERFILE -e LOVE_IMAGE -e LOVE_IMAGE_PULL -v "$PWD:/setup" --entrypoint node "$LOVE_IMAGE" /app/scripts/setup.mjs --output /setup/.env
  [ "$mode" = setup ] && exit 0
fi
[ -f .env ] || { echo '配置不存在，请先运行 ./love setup。' >&2; exit 1; }
database=$(setting LOVE_DATABASE)
https=$(setting LOVE_HTTPS)
tls=$(setting LOVE_TLS_PROVIDER)
project=$(setting COMPOSE_PROJECT_NAME)
[ -n "$project" ] || project=love-v4
set -- docker compose --project-name "$project" --env-file .env -f compose.yml
[ "$database" != postgres ] || set -- "$@" -f compose.postgres.yml
if [ "$https" = 1 ]; then
  case "$tls" in
    certbot) set -- "$@" -f compose.certbot.yml --profile https ;;
    external) ;;
    caddy|'') set -- "$@" --profile https ;;
    *) echo 'HTTPS 证书方式无效，请运行 ./love setup。' >&2; exit 1 ;;
  esac
fi
case "$mode" in
 up)
   # Disable the bundled proxy when switching to plain HTTP or an external proxy.
   if [ "$https" != 1 ] || [ "$tls" = external ]; then
     "$@" --profile https stop proxy
   fi
   if [ "$LOVE_IMAGE" = love-app:local ]; then
     exec "$@" up -d --build --remove-orphans --wait
   else
     prepare_image
     exec "$@" up -d --no-build --pull missing --remove-orphans --wait
   fi ;;
 down) exec "$@" down --remove-orphans ;;
 logs) exec "$@" logs -f ;;
 ps) exec "$@" ps ;;
esac
